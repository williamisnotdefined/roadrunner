{
  "name": "roadrunner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "roadrunner": "dist/src/cli.js"
  },
  "scripts": {
    "ai:check": "tsx scripts/ai/sync-routes.ts --check",
    "ai:sync": "tsx scripts/ai/sync-routes.ts",
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run coverage && npm run ai:check && npm run build",
    "coverage": "vitest run --coverage",
    "e2e:real": "ROADRUNNER_E2E_REAL_OPENCODE=1 tsx tests/e2e-real/todo-crud.real-e2e.ts",
    "format": "npm run ai:sync",
    "lint": "npm run ai:check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
