{
  "name": "roadrunner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "roadrunner": "dist/src/cli.js"
  },
  "scripts": {
    "ai:check": "tsx scripts/ai/sync-routes.ts --check",
    "ai:sync": "tsx scripts/ai/sync-routes.ts",
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run ai:check && npm run build",
    "format": "npm run ai:sync",
    "lint": "npm run ai:check",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
