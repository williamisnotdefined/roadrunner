{
  "name": "roadrunner",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "roadrunner": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "templates",
    "README.md"
  ],
  "scripts": {
    "ai:check": "tsx scripts/ai/sync-routes.ts --check",
    "ai:sync": "tsx scripts/ai/sync-routes.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run size:check && npm run typecheck && npm run coverage && npm run build && npm run smoke:dist && npm run smoke:pack",
    "coverage": "vitest run --coverage",
    "e2e:real": "tsx scripts/e2e-real.ts",
    "format": "npm run ai:sync && biome format --write .",
    "lint": "biome lint . && npm run ai:check",
    "prepack": "npm run build",
    "smoke:dist": "node dist/src/cli/index.js help",
    "smoke:pack": "tsx scripts/smoke-pack.ts",
    "size:check": "tsx scripts/check-file-size.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/blessed": "^0.1.27",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.6.2"
  }
}
